<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" namespace="" author="Jutsu" created="2026-10-20" changedby="Jutsu" changed="2026-10-20" origin="Structorizer 3.32-35" text="&#34;FFT&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;stagepow = 2;&#34;,&#34;N = 2^len;&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;while (stagepow &#60;= N)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;half = stagepow/2;&#34;,&#34;domega=exp(-2*pi*i/stagepow)&#34;,&#34;k=0&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
				<while text="&#34;while (k&#60;N)&#34;" comment="&#34;&#34;" color="ffffff" disabled="0">
					<qWhile>
						<instruction text="&#34;omega = 1&#34;,&#34;j=k&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
						<while text="&#34;while (j &#60; k + half)&#34;" comment="" color="ffffff" disabled="0">
							<qWhile>
								<instruction text="&#34;t = omega * MEM(j+half)&#34;,&#34;u = MEM(j)&#34;,&#34;MEM(j)=u+t&#34;,&#34;MEM(j+half)=u-t&#34;,&#34;omega= omega * domega&#34;,&#34;j=j+1&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
							</qWhile>
						</while>
						<instruction text="&#34;k = k+stagepow&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qWhile>
				</while>
			</qWhile>
		</while>
		<instruction text="&#34;stagepow = 2*stagepow&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>